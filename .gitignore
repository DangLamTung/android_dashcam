# Release signing material — must never be committed. Losing the keystore means the app can
# never be updated in place again, and leaking it lets anyone else publish as this app.
keystore.properties
*.jks
*.keystore

# Local machine configuration (SDK path).
local.properties

# Build output
.gradle/
build/
app/build/
captures/
.externalNativeBuild/
.cxx/

# IDE
.idea/
*.iml
.DS_Store

# Python bytecode from the reverse-engineering helpers in tools/
__pycache__/
*.pyc

# On-device logs pulled with adb
*.log

# Test recordings pulled off the device into the repo root
/*.mkv
/*.srt
